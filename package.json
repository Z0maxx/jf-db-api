{
  "name": "@jf-db-api",
  "dependencies": {
    "@mikro-orm/core": "^7.1.14",
    "@mikro-orm/entity-generator": "^7.1.14",
    "@mikro-orm/mariadb": "^7.1.14",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql": "^2.18.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.1.14",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mysql": "^2.15.27",
    "@types/node": "26.0.0",
    "@types/supertest": "^7.2.1",
    "nodemon": "3.1.14",
    "oxfmt": "^0.45.0",
    "supertest": "^7.2.2",
    "ts-node": "10.9.2",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts,json --ignore src/test --exec tsx src/server.ts",
    "format": "oxfmt src/",
    "test:api": "vitest --config ./vitest.api.config.ts --configLoader runner"
  },
  "imports": {
    "#/*": "./src/*"
